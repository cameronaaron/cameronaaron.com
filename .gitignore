# Next.js .gitignore

# Dependency directories
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js build output
# next.js
/.next/
/out/
/.vercel/
.wrangler/
.dev.vars

# Production build files
.build/
dist/

# Testing
coverage/
.nyc_output/

# Playwright artifacts
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Lighthouse and local audit artifacts
.lighthouseci/
.chrome-bin/
lighthouse-*.report.html
lighthouse-*.report.json
lighthouse-live*.json
lighthouse-local*.json
# Catch-all for ad-hoc local `lighthouse`/`lhci` CLI output (any naming scheme
# the CLI's --output-path produces, not just the lighthouse-*/lhci-* prefixes above).
lh-*.json
lh-*.html
lh-*.report.json
lh-*.report.html
lhr-*.json
lhr-*.html
*.lighthouseci/
# Lighthouse trace artifacts (Chrome DevTools protocol output).
# The "false/" directory name comes from CLI runs where --output-path was
# accidentally set to a boolean-string path component instead of a real path.
false/
/trace.json
/artifacts.json
/devtoolslog.json
# LHCI per-run trace bundles (any directory named after a run ID)
/lhci-*/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Vercel
.vercel

# npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.idea
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db
*.log

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Turbopack cache
.turbo/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Strict root-level local artifacts (keep repo focused on deployable site assets)
/*.txt
/*.pdf
/*.doc
/*.docx
/*.ppt
/*.pptx
/*.rtf
/*.csv
/*.tsv
/*.xls
/*.xlsx
/*.zip
/*.tar
/*.gz
/*.7z
/*.rar
/*.pem
/*.key.pem
/*.crt
/*.cer
/*.p12
/*.mobileconfig
/*.key
/*.pages
/*.numbers
/*.tmp
/*.bak
/*.orig
/Screenshot *
/Copy of *

# Local personal/reference artifacts (not part of deployed site)
/Cameron_Aaron_Medical_Resume*.md
/_local_archive/

# DNS and Cloudflare one-off operational artifacts (not part of deployed site)
2eschool.org.bind.zone
*.bind.zone
*.zone
*.zone.bak
dns-export-*.txt
cloudflare-dns-*.json
unnamed-1.webp

# Claude Code local tooling state (permission grants, machine-specific)
.claude/

# Local-only helper files with sensitive network captures (auth tokens,
# cookies) — never meant for the repo, per its own name.
nottobecommitedforbotonly/
