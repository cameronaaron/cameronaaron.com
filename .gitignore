# Next.js .gitignore

# Dependency directories
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/

# Production build files
.build/
dist/

# Environment variables
.env.local
.env.development.local
.env.test.local
.env.production.local

# Security
.env*

# npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
