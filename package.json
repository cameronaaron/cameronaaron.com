{
  "name": "cameron-aaron-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "wrangler dev",
    "deploy:prod": "npm run build && wrangler deploy --env production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "generate:icons": "node scripts/generate-icons.mjs",
    "prebuild": "node scripts/generate-icons.mjs",
    "lighthouse": "npm run lighthouse:desktop",
    "lighthouse:desktop": "lighthouse http://localhost:3000 --preset=desktop --view",
    "lighthouse:mobile": "lighthouse http://localhost:3000 --preset=mobile --view"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "lenis": "^1.3.23",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@cloudflare/kv-asset-handler": "^0.5.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "baseline-browser-mapping": "^2.10.32",
    "beasties": "^0.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "lighthouse": "^13.3.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.94.0"
  }
