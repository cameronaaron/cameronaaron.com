# Cloudflare Pages Headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Service Worker - no cache, always fresh
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript

# Offline page - cache for 1 hour
/offline.html
  Cache-Control: public, max-age=3600
  Content-Type: text/html

# Cache static assets for 1 year with immutable
/:all*(js|css|svg|jpg|jpeg|png|webp|avif|gif|ico|woff|woff2|ttf|eot)
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *

# Keep not-found responses uncached like the legacy worker 404 handler
/404.html
  Cache-Control: no-store, max-age=0, must-revalidate

# Cache Next.js static files for 1 year
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin

# Security headers for all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# HTML files with smart caching and link prefetch
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  Link: </images/profile-hero.avif>; rel=preload; as=image; type=image/avif; media="(min-width: 640px)"
  Link: </images/profile-hero-sm.avif>; rel=preload; as=image; type=image/avif; media="(max-width: 639px)"

# Manifest with proper caching
/manifest.json
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json
  Access-Control-Allow-Origin: *

# Sitemap and robots with proper content types
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml

/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain

# /bridging-transitions embeds the YouTube playlist the printed SNS26 poster's
# QR code points at, so it is the one route that CANNOT carry the site-wide
# Cross-Origin-Embedder-Policy: require-corp above.
#
# Measured, not assumed (scripts/checks/coep-youtube-embed-probe.mjs): under
# require-corp a real Chrome refuses to commit the youtube-nocookie frame at
# all — the frame stays empty with no console error. `credentialless` does not
# help either; COEP relaxes SUBRESOURCE loading, but a nested DOCUMENT still
# has to assert COEP itself, and YouTube only sends
# cross-origin-embedder-policy-REPORT-ONLY. With no COEP header the same frame
# loads normally.
#
# Detaching it costs this page cross-origin isolation, which nothing on this
# site uses (no SharedArrayBuffer, no high-resolution timers anywhere in src/).
# Every other security header — COOP, HSTS, nosniff, XFO, Permissions-Policy —
# still applies from the /* block. Pinned by headers-integrity-contract.
/bridging-transitions
  ! Cross-Origin-Embedder-Policy

/bridging-transitions.html
  ! Cross-Origin-Embedder-Policy

# Poster PDFs. NOT immutable, and not marked so: the filenames carry no
# content hash, and the files ARE rewritten in place whenever the poster is
# rebuilt in cameronaaron/bridging-transitions-poster.
#
# They were briefly served as `immutable, max-age=31536000` on the claim that
# they were "content-addressed by name". That claim was false and it bit
# within the day (2026-09-06): the poster was rebuilt to repoint its QR code,
# the new bytes deployed, and the edge kept serving the year-cached old file —
# a poster whose printed code led back to the site root. Recovering it took an
# explicit Cloudflare purge, and every visitor who had already fetched it
# would have held the wrong poster in their browser cache for a year.
#
# `immutable` is a promise about the URL, not a speed setting. Only re-add it
# here if the filenames start carrying a content hash. Pinned by
# headers-integrity-contract.
/poster/*
  Cache-Control: public, max-age=300, must-revalidate
  Content-Type: application/pdf
